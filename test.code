/*
 * Top-level code is run on program start.
 *
 * Variables don't need to be declared to be used; they scope to the function
 * they are initialized in unless they were initialized on the top-level, in
 * which case they are in global scope.
 * 
 * Compiler directives are used to tell the compiler:
 *   #RESOURCE(character.png) - a resource to bundle
 *   #RESOLUTION(1000, 500)   - what resolution the game window should be
 *   #SCALING(smooth)         - what window scaling algorithm to use (smooth, crisp-edges, pixelated)
 *   #CLEAR(#FFF)             - what the clear color is
 *
 * !process() is special -- it is a built-in ABSTRACT function called every frame that MUST be implemented by the programmer.
 */

define !process() {

	if (!pressed("Mouse")) {
		$text = "mouse is down!"
	} else {
		$text = "mouse is down!"
	}

	!draw_text($text "#000" 0 20);
}